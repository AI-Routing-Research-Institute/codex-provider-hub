# Python generated files
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/
.worktrees/
.build/
dist/

# Local private configuration and credentials
config/providers.toml
config/*.private.toml
.env
.env.*
!.env.example
secrets/
private/
*.pem
*.key
*.p12
*.pfx

# Probe reports and one-off diagnostics
reports/
probe-result*.json
probe-debug*.json
direct-current-response.txt
*.log
*.tmp

# Local proxy/control databases created during desktop runs
*.sqlite3
*.sqlite3-*
*.db
*.db-*

# UI development dependencies (编译后的 CSS 会提交，node_modules 不提交)
proxy_static/dev/node_modules/
proxy_static/dev/package-lock.json
proxy_static/node_modules/
proxy_static/dist/
